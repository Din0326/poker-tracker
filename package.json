    "check:strings": "node scripts/check-hardcoded.mjs strings",
    "check:colors": "node scripts/check-hardcoded.mjs colors",
    "check": "npm run typecheck && npm run lint && npm run check:strings && npm run check:colors && npm run test",
    "screenshots": "node scripts/screenshots.mjs",
    "gto-check": "jiti scripts/make-gto-wizard-check.ts"
  },
  "dependencies": {
